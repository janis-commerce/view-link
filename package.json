{
  "name": "@janiscommerce/view-link",
  "version": "1.1.0",
  "description": "A package for creating Janis views links",
  "main": "lib/view-link.js",
  "scripts": {
    "test": "export TEST_ENV=true; mocha --exit -R nyan --recursive tests/",
    "coverage-ci": "nyc --reporter=lcov --reporter=text-summary mocha --exit --recursive tests/",
    "watch-test": "export TEST_ENV=true; mocha --exit -R nyan -w --recursive tests/",
    "coverage": "nyc npm test",
    "lint": "eslint lib/ tests/",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janis-commerce/view-link.git"
  },
  "author": "Janis",
  "license": "ISC",
  "homepage": "https://github.com/janis-commerce/view-link.git#readme",
  "devDependencies": {
    "husky": "^7.0.4",
    "eslint": "^8.8.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.22.1",
    "mocha": "^9.2.0",
    "nyc": "^15.1.0",
    "sinon": "^13.0.1"
  },
  "files": [
    "lib/"
  ],
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "@janiscommerce/settings": "^1.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
